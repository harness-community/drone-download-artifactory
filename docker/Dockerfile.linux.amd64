FROM alpine:3.24 as alpine
RUN apk add -U --no-cache ca-certificates

FROM alpine:3.24
ENV GODEBUG netdns=go
ENV CI=true
COPY --from=alpine /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Install jfrog cli with version 2.119.0 (CVE-2026-71556: go-git/go-git/v5 bundled in jfrog-cli
# must be >= v5.19.2; v2.119.0 is the first jfrog-cli release shipping that go-git version)
RUN apk add --update \
    curl \
    && rm -rf /var/cache/apk/*
RUN curl -fL https://getcli.jfrog.io/v2-jf | sh /dev/stdin 2.119.0
RUN mv ./jf /usr/local/bin/jfrog
RUN chmod +x /usr/local/bin/jfrog

ADD release/linux/amd64/plugin /bin/
ENTRYPOINT ["/bin/plugin"]
