# INC-2000 (eMudhra intermediate CA compromise).
#  - The plugin binary (built by CI with golang:1.26.10) and the JFrog CLI both need Go >= 1.26.10 / 1.27.3.
#    No upstream JFrog CLI release is built with a fixed Go yet (2.128.0 uses 1.26.9), so `jf` is compiled
#    here from the pinned release tag. Switch back to downloading the release binary once upstream ships
#    one built with Go >= 1.26.10, and check with: go version -m <jf binary>
#  - The OS bundle must come from ca-certificates >= 20261020-r0, which drops "emSign ECC Root CA - G3"
#    and "AAA Certificate Services".
ARG GO_VERSION=1.26.10
ARG JF_CLI_VERSION=2.128.0
# The commit check replaces a checksum: the build fails if the upstream tag is moved.
ARG JF_CLI_COMMIT=a2b1b2d308bb645811d3153b2d4a89803b37fb74
ARG CA_CERTIFICATES_VERSION=20261020-r0

FROM golang:${GO_VERSION}-alpine AS jf-build
ARG JF_CLI_VERSION
ARG JF_CLI_COMMIT
ENV GOTOOLCHAIN=local CGO_ENABLED=0
RUN apk add --no-cache git
WORKDIR /src
# CVE-2026-84445 (DBOPS-3329): newest JFrog CLI release v2.128.0 (and master at the
# same commit) still requires google.golang.org/grpc v1.83.1. No CLI tag selects
# >= v1.83.2, so pin that minimum patch while compiling jf from the pinned tag.
# Drop this go get once a CLI tag's go.sum selects grpc >= v1.83.2.
RUN git clone --depth 1 --branch "v${JF_CLI_VERSION}" https://github.com/jfrog/jfrog-cli.git . \
 && test "$(git rev-parse HEAD)" = "${JF_CLI_COMMIT}" \
 && go get google.golang.org/grpc@v1.83.2 \
 && go build -trimpath -ldflags '-w -extldflags "-static"' -o /jf main.go \
 && go version -m /jf | awk '$2=="google.golang.org/grpc" && $3=="v1.83.2" { found=1 } END { exit !found }'

FROM alpine:3.24
ARG CA_CERTIFICATES_VERSION
ENV GODEBUG=netdns=go
ENV CI=true

# ${VAR:?} fails the build if the pin is ever unset. The mozilla/ listing proves the roots are gone.
# Do not copy a CA bundle from another stage over this one: it would overwrite the patched bundle.
RUN apk add --update --no-cache --upgrade \
    "ca-certificates>=${CA_CERTIFICATES_VERSION:?}" \
    "ca-certificates-bundle>=${CA_CERTIFICATES_VERSION:?}" \
    curl \
    && ! ls /usr/share/ca-certificates/mozilla | grep -iE 'emsign_ecc_root_ca_-_g3|aaa_certificate' \
    && rm -rf /var/cache/apk/*

COPY --from=jf-build /jf /usr/local/bin/jfrog

ADD release/linux/amd64/plugin /bin/
ENTRYPOINT ["/bin/plugin"]
